{
  "name": "purchase-master",
  "version": "7.4.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "lint": "tsc --noEmit",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "electron:build": "vite build && electron-builder --win",
    "build:exe": "vite build && electron-builder --win nsis portable",
    "pack:exe": "vite build && electron-builder --win --dir"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.0",
    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "recharts": "^2.13.0",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jszip": "^3.4.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "com.zenterprime.erp",
    "productName": "ZenterPrime",
    "copyright": "Copyright © 2026 ZenterPrime",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZenterPrime"
    }
  }
}
